	(IN DUCHESS-LAWN)
	(SYNONYM FOOTMAN FROG)
	(ADJECTIVE FROG)
	(DESC "Frog-Footman")
	(FLAGS ACTORBIT NDESCBIT)
	(ACTION FROG-FOOTMAN-FCN)>


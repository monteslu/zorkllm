	(SYNONYM DOOR TREE HANDLE HINGES)
	(ADJECTIVE PROPER BARK)
	(DESC "door in the tree")
	(FLAGS DOORBIT NDESCBIT)
	(ACTION TREE-DOOR-FCN)>


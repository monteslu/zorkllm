	(IN CROSSROADS)
	(SYNONYM CAT GRIN)
	(ADJECTIVE CHESHIRE GRINNING)
	(DESC "Cheshire Cat")
	(FLAGS ACTORBIT NDESCBIT)
	(ACTION CHESHIRE-CAT-FCN)>

